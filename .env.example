# Resend transactional email (appointment requests)
RESEND_API_KEY=
APPOINTMENT_TO_EMAIL=front-desk@auroragentledentist.com
APPOINTMENT_FROM_EMAIL=Ammari Dental <appointments@auroragentledentist.com>

# Public site URL used by sitemap.ts / canonical tags
NEXT_PUBLIC_SITE_URL=https://www.auroragentledentist.com

# Supabase — Get these from Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-secret-key-here
