# Resend — transactional email (appointment requests + booking confirmations)
RESEND_API_KEY=
APPOINTMENT_FROM_EMAIL=
APPOINTMENT_TO_EMAIL=

# Booking feature flag
#   off      Legacy "request" form (default). /api/booking/* returns 404.
#   preview  Real picker only when the URL has ?booking=1 (staff QA in prod).
#   on       Real picker for everyone.
NEXT_PUBLIC_BOOKING_FLAG=off

# NexHealth — real scheduling backend. Leave blank to use the mock client.
# When all three are set the booking client switches to NexHealth automatically.
NEXHEALTH_API_KEY=
NEXHEALTH_SUBDOMAIN=
NEXHEALTH_LOCATION_ID=

# HMAC secret for cancel / manage / .ics deep-link tokens. 32+ random chars.
# REQUIRED in production. Dev falls back to a baked-in value (never use it
# anywhere real).
BOOKING_SIGNING_SECRET=

# Force the mock booking client even when NexHealth env vars are set.
# Useful for QA against production-shaped data without touching real bookings.
# Leave unset / 0 in production.
BOOKING_MOCK=
