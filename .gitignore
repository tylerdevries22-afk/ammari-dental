# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template must stay committable, or `git add .env.example`
# silently does nothing and onboarding has no reference.
!.env.example

# Large source media parked in the repo root. These are NOT build inputs —
# without this guard a single `git add -A` writes ~43 MB into history.
/*.mp4
/*.mov

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/worktrees/
.claude/scheduled_tasks.lock

# playwright
/test-results/
/playwright-report/
/playwright/.cache/
